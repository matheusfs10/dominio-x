{
  "name": "dominio-x",
  "version": "0.1.0",
  "private": true,
  "description": "Dominio-X — internal domain intelligence platform",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @dominio-x/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @dominio-x/database generate",
    "db:migrate": "pnpm --filter @dominio-x/database migrate",
    "db:seed": "pnpm --filter @dominio-x/database seed",
    "admin:create": "pnpm --filter @dominio-x/database admin:create",
    "scheduler:registro-br": "pnpm --filter @dominio-x/scheduler start",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "@dominio-x/test-utils": "workspace:*"
  }
}

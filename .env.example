NODE_ENV=development

# API / Web
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000

# Security (generate with: openssl rand -hex 32)
SESSION_SECRET=
CRAWLER_MACHINE_TOKEN=

# Bootstrap admin (remove after the first successful seed)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# PostgreSQL
DATABASE_URL=postgresql://dominiox:dominiox@localhost:5432/dominiox

# Redis
REDIS_URL=redis://localhost:6379

# Storage (S3-compatible: Railway Bucket in production, MinIO locally).
# Set STORAGE_DRIVER=fs to use a local folder (development only) when no S3 is available.
STORAGE_DRIVER=s3
STORAGE_FS_ROOT=.data/storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_BUCKET=dominio-x-data
S3_REGION=us-east-1
S3_URL_STYLE=path

# Registro.br
REGISTRO_BR_RELEASE_URL=https://registro.br/dominio/lista-processo-liberacao.txt
REGISTRO_BR_USER_AGENT=Dominio-X/1.0 (+internal-domain-intelligence)
REGISTRO_BR_TIMEOUT_MS=30000

# Semrush (provider integration mode is on STANDBY — see docs/providers.md)
SEMRUSH_ENABLED=false
SEMRUSH_API_KEY=
SEMRUSH_MAX_RPS=8
SEMRUSH_MAX_CONCURRENCY=8
SEMRUSH_DATA_TTL_DAYS=30
SEMRUSH_MONTHLY_UNIT_BUDGET=

# DataForSEO — estimated search traffic (paid; runs only behind the free traffic gate).
# Credentials are the API login/password from the DataForSEO dashboard, not the account password.
DATAFORSEO_ENABLED=false
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com
# Google geo target id of the audience to measure: 2076 = Brazil.
DATAFORSEO_LOCATION_CODE=2076
DATAFORSEO_LOCATION_NAME=Brazil
DATAFORSEO_LANGUAGE_CODE=pt
DATAFORSEO_WINDOW_MONTHS=6
DATAFORSEO_MAX_RPS=2
DATAFORSEO_MAX_CONCURRENCY=2
DATAFORSEO_DATA_TTL_DAYS=30
# Hard USD ceiling per calendar month. The Settings > traffic gate value may only lower it.
DATAFORSEO_MONTHLY_COST_BUDGET_USD=20
DATAFORSEO_ESTIMATED_COST_PER_CALL_USD=0.02
DATAFORSEO_BALANCE_CACHE_SECONDS=300
DATAFORSEO_TIMEOUT_MS=20000

# CapSolver — resolve o desafio Cloudflare Turnstile das ferramentas gratuitas do Ahrefs.
# Cobrado por token resolvido: o custo de uma consulta de autoridade é o custo de um solve.
CAPSOLVER_ENABLED=false
CAPSOLVER_API_KEY=
CAPSOLVER_BASE_URL=https://api.capsolver.com
CAPSOLVER_APP_ID=
CAPSOLVER_TIMEOUT_MS=20000
CAPSOLVER_POLL_INTERVAL_MS=3000
CAPSOLVER_MAX_WAIT_MS=120000
CAPSOLVER_BALANCE_CACHE_SECONDS=300
# Preço de um token resolvido, conforme a tabela do fornecedor. É o valor gravado no ledger.
CAPSOLVER_COST_PER_SOLVE_USD=0.001

# Ahrefs — Domain Rating do backlink checker público (roda depois das regras, atrás do gate
# de autoridade). Não há chave de API: cada consulta precisa de um captcha resolvido.
AHREFS_ENABLED=false
AHREFS_BASE_URL=https://ahrefs.com
# exact | prefix | domain | subdomains
AHREFS_MODE=subdomains
AHREFS_TARGET_SCHEME=https
AHREFS_TURNSTILE_SITEKEY=0x4AAAAAAAAzi9ITzSN9xKMi
AHREFS_USER_AGENT=
AHREFS_CLIENT_VERSION=
# Só preencher se o WAF passar a desafiar o IP de saída (cookie cf_clearance obtido fora da banda).
AHREFS_COOKIE=
AHREFS_MAX_RPS=0.2
AHREFS_MAX_CONCURRENCY=1
AHREFS_DATA_TTL_DAYS=30
# Teto em US$ por mês-calendário. O valor em Configurações › Gate de autoridade só pode baixá-lo.
AHREFS_MONTHLY_COST_BUDGET_USD=10
AHREFS_TIMEOUT_MS=30000

# Crawler (core side)
CRAWLER_ENABLED=true
CRAWLER_JOB_LEASE_SECONDS=120
CRAWLER_STAGE_WAIT_TIMEOUT_MS=600000

# Crawler (crawler service side)
CRAWLER_CORE_API_URL=http://localhost:4000
CRAWLER_CONNECT_TIMEOUT_MS=5000
CRAWLER_TOTAL_TIMEOUT_MS=12000
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_BODY_BYTES=2097152
CRAWLER_MAX_DECOMPRESSED_BYTES=4194304
CRAWLER_POLL_INTERVAL_MS=5000
CRAWLER_CONCURRENCY=4

# Pipeline
PIPELINE_WORKER_CONCURRENCY=5
DNS_TTL_HOURS=24
HTTP_TTL_HOURS=72

# Observability
SENTRY_DSN=
LOG_LEVEL=info

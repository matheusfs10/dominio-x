{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm turbo run build --filter=@dominio-x/worker",
    "watchPatterns": [
      "apps/worker/**",
      "packages/**",
      "pnpm-lock.yaml",
      "package.json",
      "turbo.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/worker/dist/worker.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

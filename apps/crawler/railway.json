{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm turbo run build --filter=@dominio-x/crawler",
    "watchPatterns": [
      "apps/crawler/**",
      "packages/config/**",
      "packages/contracts/**",
      "packages/observability/**",
      "pnpm-lock.yaml",
      "package.json",
      "turbo.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/crawler/dist/crawler.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

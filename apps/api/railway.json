{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm turbo run build --filter=@dominio-x/api --filter=@dominio-x/database",
    "watchPatterns": ["apps/api/**", "packages/**", "pnpm-lock.yaml", "package.json", "turbo.json"]
  },
  "deploy": {
    "startCommand": "node apps/api/dist/server.js",
    "preDeployCommand": ["node packages/database/dist/migrate.js"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

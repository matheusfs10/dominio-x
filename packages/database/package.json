{
  "name": "@dominio-x/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsup",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "admin:create": "tsx src/admin-create.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@dominio-x/config": "workspace:*",
    "@dominio-x/contracts": "workspace:*",
    "@dominio-x/normalization": "workspace:*",
    "@node-rs/argon2": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13"
  }
}
